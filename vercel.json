{
  "buildCommand": "node scripts/build-site.cjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
    },
    {
      "source": "/manifest.json",
      "headers": [{"key": "Content-Type", "value": "application/manifest+json"}]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"},
        {"key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()"}
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/account",
      "destination": "/pages/account.html"
    },
    {
      "source": "/feedback",
      "destination": "/pages/feedback.html"
    },
    {
      "source": "/admin",
      "destination": "/pages/admin.html"
    },
    {
      "source": "/scan",
      "destination": "/pages/scan.html"
    },
    {
      "source": "/settings",
      "destination": "/pages/settings.html"
    },
    {
      "source": "/qr/logo-styling",
      "destination": "/pages/qr/logo-styling.html"
    },
    {
      "source": "/qr/wifi-vcard",
      "destination": "/pages/qr/wifi-vcard.html"
    },
    {
      "source": "/qr/business",
      "destination": "/pages/qr/business.html"
    },
    {
      "source": "/qr/campaign",
      "destination": "/pages/qr/campaign.html"
    },
    {
      "source": "/barcode",
      "destination": "/pages/barcode.html"
    },
    {
      "source": "/barcode/bulk",
      "destination": "/pages/barcode/bulk.html"
    },
    {
      "source": "/barcode/sheet-scan",
      "destination": "/pages/barcode/sheet-scan.html"
    },
    {
      "source": "/projects",
      "destination": "/pages/projects.html"
    },
    {
      "source": "/help",
      "destination": "/pages/help.html"
    },
    {
      "source": "/about",
      "destination": "/pages/about.html"
    },
    {
      "source": "/features",
      "destination": "/pages/features.html"
    },
    {
      "source": "/privacy",
      "destination": "/pages/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/pages/terms.html"
    },
    {
      "source": "/contact",
      "destination": "/pages/contact.html"
    },
    {
      "source": "/inventory/labels",
      "destination": "/pages/barcode/bulk.html"
    },
    {
      "source": "/inventory/stock",
      "destination": "/pages/barcode/bulk.html"
    },
    {
      "source": "/app",
      "destination": "/pages/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    }
  ]
}
